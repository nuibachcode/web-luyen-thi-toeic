generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ExamResult {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  examCode         String   @map("exam_code") @db.VarChar(100)
  listeningCorrect Int      @map("listening_correct") @db.SmallInt
  readingCorrect   Int      @map("reading_correct") @db.SmallInt
  listeningScore   Int      @map("listening_score") @db.SmallInt
  readingScore     Int      @map("reading_score") @db.SmallInt
  totalScore       Int      @map("total_score") @db.SmallInt
  answers          Json
  submittedAt      DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)
  @@index([userId, submittedAt])
  @@map("exam_results")
}

model Question {
  id             String   @id @default(uuid()) @db.Uuid
  examCode       String   @map("exam_code") @db.VarChar(100)
  questionNumber Int      @map("question_number") @db.SmallInt
  part           Int      @db.SmallInt
  section        String?  @db.VarChar(20)
  questionText   String?  @map("question_text")
  optionA        String?  @map("option_a")
  optionB        String?  @map("option_b")
  optionC        String?  @map("option_c")
  optionD        String?  @map("option_d")
  correctAnswer  String?  @map("correct_answer") @db.VarChar(1)
  explanationVi  String?  @map("explanation_vi")
  explanationEn  String?  @map("explanation_en")
  audioUrl       String?  @map("audio_url")
  imageUrl       String?  @map("image_url")
  passageId      String?  @map("passage_id") @db.VarChar(100)
  passageText    String?  @map("passage_text")
  passageAudio   String?  @map("passage_audio")
  passageImage   String?  @map("passage_image")
  tuVung         Json?    @map("tu_vung")
  rawData        Json?    @map("raw_data")
  @@unique([examCode, questionNumber])
  @@index([examCode])
  @@index([examCode, part])
  @@map("questions")
}

model AiStudentProfile {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  targetScore       Int      @default(750) @map("target_score") @db.SmallInt
  durationDays      Int      @default(30) @map("duration_days") @db.SmallInt
  activeRoadmap     Json?    @map("active_roadmap")
  dailyLessonsCache Json?    @map("daily_lessons_cache")
  dailyQuizResults  Json?    @map("daily_quiz_results")
  completedTaskKeys Json?    @map("completed_task_keys")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@map("ai_student_profiles")
}
